# Copy to .env.local and fill in. Never commit .env.local.
GOOGLE_SHEET_ID=10iI9lBh7dONs7acW0SqSRoHHzgljbUP724xBCPwpxkk

# Google auth — pick ONE of the two options below.
#
# Option A (preferred): paste the ENTIRE service-account JSON as one value.
# This matches the rest of the fleet. In Vercel, paste the whole file.
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n","client_email":"xxx@yyy.iam.gserviceaccount.com", ...}
#
# Option B (fallback): the split email + key pair. Used only when
# GOOGLE_CREDENTIALS is unset.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@yyy.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# Shared password for the whole dashboard. Required. In production the app
# refuses to serve (503) if this is unset, so a misconfigured deploy can
# never expose the client's financials.
DASHBOARD_PASSWORD=changeme
